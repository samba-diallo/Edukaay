# Configuration Backend EduKaay - EXEMPLE

# --- Base de Données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=edukaay_db

# --- Serveur ---
NODE_ENV=development
PORT=5000

# --- URLs Frontend et Mobile ---
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://localhost:19000

# --- JWT Token ---
JWT_SECRET=votre_clé_secrète_jwt_très_sécurisée
JWT_EXPIRE=7d

# --- Paiements ---
WAVE_API_KEY=
WAVE_API_URL=https://api.wave.com/v1
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_URL=https://api.orange.com/payment/v1
MTN_MOMO_API_KEY=
MTN_MOMO_API_URL=https://api.mtn.com/v1

# --- Commission Platform ---
PLATFORM_COMMISSION_RATE=0.15

# --- Socket.IO ---
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
